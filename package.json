{
  "name": "markpage",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:obsidian",
    "build:web": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:bridge": "node obsidian-plugin/build.mjs",
    "test:contracts": "vitest run packages/core/test packages/editor/test src/lib/document-session.test.ts tools/validate-architecture.test.ts apps/obsidian/test",
    "test:obsidian-probe": "vitest run tools/obsidian-probe",
    "build:obsidian-probe": "tsc -p tools/obsidian-probe/tsconfig.json && node tools/obsidian-probe/build.mjs",
    "prepare:obsidian-probe": "npm run build:obsidian-probe && node tools/obsidian-probe/prepare.mjs",
    "typecheck": "tsc -b && tsc -p packages/core/tsconfig.json && tsc -p packages/editor/tsconfig.json && tsc -p packages/extension-obsidian/tsconfig.json && tsc -p tools/obsidian-probe/tsconfig.json && tsc -p apps/obsidian/tsconfig.json",
    "validate:architecture": "node tools/validate-architecture.mjs",
    "build:obsidian": "tsc -p apps/obsidian/tsconfig.json && node apps/obsidian/build.mjs && npm run validate:artifact",
    "prepare:obsidian": "npm run build:obsidian && node apps/obsidian/prepare.mjs",
    "install:obsidian": "node apps/obsidian/install.mjs",
    "validate:artifact": "node apps/obsidian/validate-artifact.mjs",
    "validate:all": "npm run lint && npm run validate:architecture && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@markpage/core": "1.2.0",
    "@markpage/editor": "1.2.0",
    "@markpage/extension-obsidian": "1.2.0",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "jsdom": "^29.1.1",
    "obsidian": "1.8.7",
    "oxlint": "^1.88.0",
    "postcss": "8.5.32",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
